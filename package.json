{
  "name": "visual-anything",
  "version": "0.0.0",
  "private": true,
  "description": "Make any concept or system visual and explore it interactively.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx packages/server/src/cli.ts examples/my-systems --dev",
    "start": "pnpm build && tsx packages/server/src/cli.ts examples/my-systems",
    "build": "pnpm --recursive --if-present run build",
    "bench": "pnpm --filter @visual-anything/app run bench",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
