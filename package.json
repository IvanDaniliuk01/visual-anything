{
  "name": "visual-anything",
  "version": "0.1.4",
  "private": true,
  "description": "Make any concept or system visual and explore it interactively.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx packages/server/src/cli.ts examples/my-systems --dev",
    "start": "pnpm build && tsx packages/server/src/cli.ts examples/my-systems",
    "build": "pnpm --recursive --if-present run build",
    "bench": "pnpm --filter @visual-anything/app run bench",
    "package": "pnpm build && tsx packages/server/scripts/package.ts",
    "smoke": "tsx packages/server/scripts/smoke.ts",
    "notices": "tsx packages/server/scripts/notices-write.ts",
    "test": "vitest run --reporter=default --reporter=./scripts/skipped-tests-reporter.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc && tsc -p scripts && tsc -p packages/server/scripts && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
