{
  "name": "@visual-anything/app",
  "version": "0.1.3",
  "private": true,
  "description": "The browser app: React panels and the PixiJS canvas. It sends commands to the local program and renders what comes back.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.viewer.config.ts && vite build --config vite.solid-worker.config.ts",
    "bench": "vite build --config vite.bench.config.ts && vite preview --config vite.bench.config.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@visual-anything/core": "workspace:*",
    "@visual-anything/schema": "workspace:*",
    "elkjs": "^0.12.0",
    "katex": "0.19.1",
    "pdfkit": "^0.20.2",
    "pixi.js": "^8.22.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-to-pdfkit": "0.1.8",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/pdfkit": "0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/svg-to-pdfkit": "0.1.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "libavoid-js": "0.5.0-beta.5",
    "vite": "^8.3.5"
  }
}
