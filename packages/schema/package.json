{
  "name": "@visual-anything/schema",
  "version": "0.1.2",
  "private": true,
  "description": "Project file types and the JSON Schema generated from them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./src/validate.ts",
    "./format": "./src/format.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsx scripts/generate.ts",
    "generate": "tsx scripts/generate.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "ts-json-schema-generator": "^2.9.0"
  }
}
