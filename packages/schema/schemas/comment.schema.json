{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:visual-anything:schema:comment",
  "title": "Visual Anything comment file",
  "description": "The contents of a `.vacomment` file: one thread, the comments about one element, relation, view or point of a view, kept until it is resolved (ADR 0059). Each thread has a file of its own, so that threads added in two branches merge without a conflict.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/Id"
    },
    "anchor": {
      "$ref": "#/definitions/CommentAnchor",
      "description": "What the thread is about. A thread whose anchor is deleted is kept, as a detached thread."
    },
    "resolved": {
      "type": "boolean",
      "description": "Whether the thread is resolved; left out while it is open."
    },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ThreadComment"
      },
      "description": "The comments, oldest first.",
      "minItems": 1,
      "maxItems": 1000
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FileConflict"
      },
      "description": "What a merge could not join, as data (ADR 0072): each conflict says which item it is about, what the file keeps in place, and the other choice. Written only by a merge; the person resolves them.",
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "id",
    "anchor",
    "comments"
  ],
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "description": "An identifier, generated once and never reused. Files refer to each other only by id. Element and relation ids share one namespace, because a relation can end on either. Component and relation type ids start with their package's id, as in `systems.service`.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "CommentAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "element",
            "relation",
            "view",
            "point"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "element"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ElementAnchor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "relation"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/RelationAnchor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "view"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ViewAnchor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "point"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/PointAnchor"
          }
        }
      ],
      "description": "What a thread is about: an element, a relation, a view, or a point of a view."
    },
    "ElementAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "element"
        },
        "element": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "element"
      ],
      "additionalProperties": false,
      "description": "A thread about an element, shown on its shapes in every view that shows it."
    },
    "RelationAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "relation"
        },
        "relation": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "relation"
      ],
      "additionalProperties": false,
      "description": "A thread about a relation, shown on its line in every view that shows it."
    },
    "ViewAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "view"
        },
        "view": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "view"
      ],
      "additionalProperties": false,
      "description": "A thread about a view as a whole."
    },
    "PointAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "point"
        },
        "view": {
          "$ref": "#/definitions/Id"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": [
        "kind",
        "view",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "A thread about a point of a view, in canvas units."
    },
    "ThreadComment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "author": {
          "$ref": "#/definitions/CommentAuthor"
        },
        "time": {
          "$ref": "#/definitions/CommentTime",
          "description": "When it was written."
        },
        "edited": {
          "$ref": "#/definitions/CommentTime",
          "description": "When it was last edited, if it was."
        },
        "text": {
          "type": "string",
          "description": "Plain text, never HTML: a blank line starts a paragraph, and lines that start with \"- \", or with a number and \". \", make a list.",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "author",
        "time",
        "text"
      ],
      "additionalProperties": false,
      "description": "A remark in a thread, with its author and time."
    },
    "CommentAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "claude"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/PersonAuthor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "claude"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ClaudeAuthor"
          }
        }
      ],
      "description": "Who wrote a comment: a person, by the name and email in their preferences, or Claude."
    },
    "PersonAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "person"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+$"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "description": "A person, as their preferences name them (ADR 0032)."
    },
    "ClaudeAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "claude"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "description": "Claude."
    },
    "CommentTime": {
      "type": "string",
      "description": "A time in UTC, as ISO 8601 writes it, such as `2026-10-25T14:03:00.000Z`.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "FileConflict": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Unique within its file."
        },
        "item": {
          "type": "string",
          "description": "The item, by a key local to its file: `world`, `element:<id>`, `relation:<id>` or `order` in the model file; `package`, `component:<id>`, `relation-type:<id>` or `image:<id>` in a package file; `view`, `position:<element>`, `position:<element> in <container>`, `free-shape:<id>`, `stacking:<container>` or `route:<relation>` in a view file; `scenario`, `step:<id>`, `tour`, `tour-step:<id>`, `thread` or `comment:<id>` in theirs; `project` in the project file.",
          "minLength": 1,
          "maxLength": 300
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Where the value lies inside the item, as a list of keys; empty for the whole item.",
          "maxItems": 16
        },
        "why": {
          "$ref": "#/definitions/ConflictReason"
        },
        "kept": {
          "type": "string",
          "enum": [
            "ours",
            "theirs"
          ],
          "description": "Whose value the file holds in place."
        },
        "other": {
          "$ref": "#/definitions/JsonValue",
          "description": "The other side's value; left out when that side removed the item."
        },
        "base": {
          "$ref": "#/definitions/JsonValue",
          "description": "The common ancestor's value; left out when it had none."
        },
        "sides": {
          "$ref": "#/definitions/ConflictSides",
          "description": "The names git gave the two sides, when it gave them."
        }
      },
      "required": [
        "id",
        "item",
        "path",
        "why",
        "kept"
      ],
      "additionalProperties": false,
      "description": "What a merge of one project file could not join (ADR 0072). The file in place is a valid file of its kind; `other` and `base` are JSON as that kind of file holds the item, checked only when chosen."
    },
    "ConflictReason": {
      "type": "string",
      "enum": [
        "both-changed",
        "removed-and-changed",
        "both-added",
        "needs-removed",
        "cycle",
        "order"
      ],
      "description": "Why a merge could not join: both sides changed a value differently; one removed what the other changed; both added an id with different values; a removal meets what needs what it removes; two additions close a containment cycle; or both sides reordered a list differently."
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ],
      "description": "Any JSON value."
    },
    "ConflictSides": {
      "type": "object",
      "properties": {
        "ours": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "theirs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false,
      "description": "The names of a merge's two sides, as git gave them."
    }
  }
}
