{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:visual-anything:schema:comment",
  "title": "Visual Anything comment file",
  "description": "The contents of a `.vacomment` file: one thread, the comments about one element, relation, view or point of a view, kept until it is resolved (ADR 0059). Each thread has a file of its own, so that threads added in two branches merge without a conflict.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/Id"
    },
    "anchor": {
      "$ref": "#/definitions/CommentAnchor",
      "description": "What the thread is about. A thread whose anchor is deleted is kept, as a detached thread."
    },
    "resolved": {
      "type": "boolean",
      "description": "Whether the thread is resolved; left out while it is open."
    },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ThreadComment"
      },
      "description": "The comments, oldest first.",
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "id",
    "anchor",
    "comments"
  ],
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "description": "An identifier, generated once and never reused. Files refer to each other only by id. Element and relation ids share one namespace, because a relation can end on either. Component and relation type ids start with their package's id, as in `systems.service`.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "CommentAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "element",
            "relation",
            "view",
            "point"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "element"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ElementAnchor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "relation"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/RelationAnchor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "view"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ViewAnchor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "point"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/PointAnchor"
          }
        }
      ],
      "description": "What a thread is about: an element, a relation, a view, or a point of a view."
    },
    "ElementAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "element"
        },
        "element": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "element"
      ],
      "additionalProperties": false,
      "description": "A thread about an element, shown on its shapes in every view that shows it."
    },
    "RelationAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "relation"
        },
        "relation": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "relation"
      ],
      "additionalProperties": false,
      "description": "A thread about a relation, shown on its line in every view that shows it."
    },
    "ViewAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "view"
        },
        "view": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "view"
      ],
      "additionalProperties": false,
      "description": "A thread about a view as a whole."
    },
    "PointAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "point"
        },
        "view": {
          "$ref": "#/definitions/Id"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": [
        "kind",
        "view",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "A thread about a point of a view, in canvas units."
    },
    "ThreadComment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "author": {
          "$ref": "#/definitions/CommentAuthor"
        },
        "time": {
          "$ref": "#/definitions/CommentTime",
          "description": "When it was written."
        },
        "edited": {
          "$ref": "#/definitions/CommentTime",
          "description": "When it was last edited, if it was."
        },
        "text": {
          "type": "string",
          "description": "Plain text, never HTML: a blank line starts a paragraph, and lines that start with \"- \", or with a number and \". \", make a list.",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "author",
        "time",
        "text"
      ],
      "additionalProperties": false,
      "description": "A remark in a thread, with its author and time."
    },
    "CommentAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "claude"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/PersonAuthor"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "claude"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ClaudeAuthor"
          }
        }
      ],
      "description": "Who wrote a comment: a person, by the name and email in their preferences, or Claude."
    },
    "PersonAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "person"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+$"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "description": "A person, as their preferences name them (ADR 0032)."
    },
    "ClaudeAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "claude"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "description": "Claude."
    },
    "CommentTime": {
      "type": "string",
      "description": "A time in UTC, as ISO 8601 writes it, such as `2026-10-25T14:03:00.000Z`.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    }
  }
}
