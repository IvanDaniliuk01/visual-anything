{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:visual-anything:schema:package",
  "title": "Visual Anything package file",
  "description": "The contents of a `.vapackage` file: components and relation types from one domain, shared as a unit.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/Id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Component"
      }
    },
    "relationTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RelationType"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ImageDefinition"
      },
      "description": "The images its components' appearances, and elements' own appearances, show. Each is data only: nothing in it runs or refers to anything outside it. Left out when there are none.",
      "minItems": 1,
      "maxItems": 128
    }
  },
  "required": [
    "id",
    "name",
    "components",
    "relationTypes"
  ],
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "description": "An identifier, generated once and never reused. Files refer to each other only by id. Element and relation ids share one namespace, because a relation can end on either. Component and relation type ids start with their package's id, as in `systems.service`.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "Component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "derivesFrom": {
          "$ref": "#/definitions/Id",
          "description": "The component this one derives from: another component, or `essence`."
        },
        "description": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeDefinition"
          },
          "description": "The attributes this component adds to the ones it inherits."
        },
        "appearance": {
          "$ref": "#/definitions/Appearance"
        }
      },
      "required": [
        "id",
        "name",
        "derivesFrom"
      ],
      "additionalProperties": false,
      "description": "The reusable definition of a kind of element. It inherits everything it does not redefine."
    },
    "AttributeDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "json"
          ]
        },
        "default": {
          "$ref": "#/definitions/JsonValue",
          "description": "The value an element or relation has when it does not set its own."
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "description": "An attribute that a component or relation type defines."
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ],
      "description": "Any JSON value."
    },
    "Appearance": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "rounded-rectangle",
            "ellipse",
            "cylinder",
            "person"
          ]
        },
        "fill": {
          "$ref": "#/definitions/Color"
        },
        "stroke": {
          "$ref": "#/definitions/Color"
        },
        "width": {
          "type": "number",
          "description": "The width of its shapes when a view does not set one, in canvas units.",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "description": "The height of its shapes when a view does not set one, in canvas units.",
          "exclusiveMinimum": 0
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/definitions/AppearanceImage"
            },
            {
              "type": "string",
              "const": "none"
            }
          ],
          "description": "The image its shapes show; `none` shows none, whatever is inherited."
        }
      },
      "additionalProperties": false,
      "description": "How an element's shapes are drawn."
    },
    "Color": {
      "type": "string",
      "description": "A color written as `#rrggbb`.",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "AppearanceImage": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/Id",
          "description": "The id of an image that a package in use defines."
        },
        "placement": {
          "type": "string",
          "enum": [
            "icon",
            "drawing"
          ],
          "description": "`icon`, the default: small, beside the name, inside the shape. `drawing`: on a plate in place of the shape, with the name under it. Shapes that hold other shapes or draw rows always show it as an icon in their header, and rows as a small icon before their name."
        },
        "tint": {
          "$ref": "#/definitions/Color",
          "description": "When set, the picture is drawn as a silhouette of this colour: its shape kept, its colours replaced."
        }
      },
      "required": [
        "image"
      ],
      "additionalProperties": false,
      "description": "A picture an appearance shows."
    },
    "RelationType": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "derivesFrom": {
          "$ref": "#/definitions/Id",
          "description": "The relation type this one derives from: another relation type, or `relates-to`."
        },
        "description": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "directed",
            "undirected"
          ]
        },
        "nests": {
          "type": "boolean",
          "description": "Whether its relations place their `from` element inside their `to` element, as \"is part of\" does."
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeDefinition"
          },
          "description": "The attributes this relation type adds to the ones it inherits."
        },
        "appearance": {
          "$ref": "#/definitions/RelationAppearance"
        },
        "limits": {
          "$ref": "#/definitions/RelationTypeLimits",
          "description": "What its relations may connect. Breaking a limit only produces a warning."
        }
      },
      "required": [
        "id",
        "name",
        "derivesFrom"
      ],
      "additionalProperties": false,
      "description": "The reusable definition of a kind of relation. It inherits everything it does not redefine."
    },
    "RelationAppearance": {
      "type": "object",
      "properties": {
        "stroke": {
          "$ref": "#/definitions/Color"
        },
        "width": {
          "type": "number",
          "description": "The line width, in canvas units.",
          "exclusiveMinimum": 0
        },
        "dash": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        }
      },
      "additionalProperties": false,
      "description": "How a relation is drawn."
    },
    "RelationTypeLimits": {
      "type": "object",
      "properties": {
        "from": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "uniqueItems": true
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "What the ends of a relation type's relations may be. Each list names components or relation types; an end created from one of them, or from anything derived from one of them, keeps within the limit. A missing list sets no limit on that end."
    },
    "ImageDefinition": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "svg",
            "bitmap"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "svg"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/SvgImage"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "bitmap"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/BitmapImage"
          }
        }
      ],
      "description": "A picture a package defines, kept as the core cleaned it."
    },
    "SvgImage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "svg"
        },
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Starts with its package's id, as in `clinic.whatsapp-logo-k3f9q2`."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "description": "Where it comes from and under which licence, such as \"Simple Icons, CC0-1.0\".",
          "maxLength": 500
        },
        "width": {
          "type": "number",
          "description": "The width of its view box, which with its height gives its proportions.",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "description": "The height of its view box.",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "svg": {
          "type": "string",
          "description": "Its SVG text as the core cleans it: one `svg` element with a `viewBox`, elements and attributes from an allow-list only, and references only to its own parts.",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^<svg[ >]"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "width",
        "height",
        "svg"
      ],
      "additionalProperties": false,
      "description": "A picture drawn from SVG: shapes, paths, gradients, clipping and masks only."
    },
    "BitmapImage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "bitmap"
        },
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Starts with its package's id, as in `clinic.front-desk-4fj2ka`."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "description": "Where it comes from and under which licence.",
          "maxLength": 500
        },
        "format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "width": {
          "type": "number",
          "description": "Its width in pixels, as its header gives it.",
          "minimum": 1,
          "maximum": 1024
        },
        "height": {
          "type": "number",
          "description": "Its height in pixels, as its header gives it.",
          "minimum": 1,
          "maximum": 1024
        },
        "data": {
          "type": "string",
          "description": "Its bytes in base64.",
          "minLength": 4,
          "maxLength": 262144,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "format",
        "width",
        "height",
        "data"
      ],
      "additionalProperties": false,
      "description": "A picture kept as the bytes of a PNG, JPEG or WebP file, without its metadata."
    }
  }
}
