{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:visual-anything:schema:view",
  "title": "Visual Anything view file",
  "description": "The contents of a `.vaview` file: a projection of the model onto the canvas, with its own positions.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/Id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "perspective": {
      "$ref": "#/definitions/Perspective"
    },
    "nestingRelationTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Id"
      },
      "description": "The nesting relation types that arrange this view.",
      "uniqueItems": true
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ShapePosition"
      },
      "description": "The positions of anchored shapes, set by layout or pinned by hand. A shape without a position is placed by layout."
    },
    "freeShapes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FreeShape"
      }
    },
    "stackingOrder": {
      "$ref": "#/definitions/StackingOrder",
      "description": "The order in which this view draws the anchored shapes that sit directly inside each container, or directly in World, by the id of the container, or World's id. Each list goes from back to front: the shapes it does not name are drawn in front of the ones it names, in model order, so without a list every shape there is drawn in model order and a new shape comes in front. Every copy of a container draws its contents in the same order. An id whose element does not sit there is ignored."
    },
    "collapsed": {
      "$ref": "#/definitions/CollapsedList",
      "description": "The containers this view shows collapsed, by element id, sorted. A collapsed container's shapes show none of its contents, and the relations to and from them are drawn as aggregated relations. An id that is no element of the model is ignored."
    },
    "routes": {
      "$ref": "#/definitions/Routes",
      "description": "The relations this view routes by hand, by relation id, each with only what differs from its automatic route: where its ends attach, the points it bends at, and its style. A relation it does not name is routed automatically, and a route whose relation is no relation of the model is ignored."
    },
    "scope": {
      "$ref": "#/definitions/Scope",
      "description": "The part of the model this view shows (ADR 0040). Without it, the view shows the whole model."
    },
    "relationTypesLeftOut": {
      "$ref": "#/definitions/RelationTypesLeftOut",
      "description": "The relation types whose relations this view does not draw (ADR 0064): not as lines, not in a collapsed container's aggregated relations, and in no count of relations that leave the view. Such a relation stays in the model. A relation type the view nests by draws containment, so it is never left out. Left out when it has none."
    },
    "overlays": {
      "$ref": "#/definitions/Overlays",
      "description": "How this view colors, sizes, marks or fades its shapes by their attributes, in order (ADR 0055): each channel of a shape is set by the first overlay that sets it. Left out when it has none."
    }
  },
  "required": [
    "id",
    "name",
    "perspective",
    "nestingRelationTypes",
    "positions",
    "freeShapes"
  ],
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "description": "An identifier, generated once and never reused. Files refer to each other only by id. Element and relation ids share one namespace, because a relation can end on either. Component and relation type ids start with their package's id, as in `systems.service`.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "Perspective": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "For example \"Data flow\", \"Security\" or \"Ownership\".",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "The criterion for selecting and arranging the model in a view."
    },
    "ShapePosition": {
      "type": "object",
      "properties": {
        "element": {
          "$ref": "#/definitions/Id"
        },
        "container": {
          "$ref": "#/definitions/Id",
          "description": "The container whose shape holds this one. Absent when the element sits directly in World."
        },
        "x": {
          "type": "number",
          "description": "The left edge, relative to the container's shape, or to the canvas when directly in World.",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "description": "The top edge, relative to the container's shape, or to the canvas when directly in World.",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the position was set by hand. Layout arranges every other shape around pinned shapes."
        }
      },
      "required": [
        "element",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "Where an anchored shape sits in a view. An element has one anchored shape inside each of its containers, so a position is identified by the element and the container its shape sits in."
    },
    "FreeShape": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "note",
            "arrow"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "note"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/Note"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "arrow"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/Arrow"
          }
        }
      ],
      "description": "A shape that is drawing only and does not exist in the model."
    },
    "Note": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "note"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "x": {
          "type": "number",
          "description": "Its left edge on the canvas.",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "description": "Its top edge on the canvas.",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "text": {
          "type": "string"
        },
        "fill": {
          "$ref": "#/definitions/Color",
          "description": "Its fill; without one, the theme's note color."
        },
        "stroke": {
          "$ref": "#/definitions/Color",
          "description": "Its stroke; without one, the theme's."
        }
      },
      "required": [
        "kind",
        "id",
        "x",
        "y",
        "width",
        "height",
        "text"
      ],
      "additionalProperties": false,
      "description": "A free shape that holds text."
    },
    "Color": {
      "type": "string",
      "description": "A color written as `#RRGGBB`: no alpha, no short form and no names. Files may write the digits in either case; the program writes new colors in capitals and keeps a color's spelling when it is set to the same color again.",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "Arrow": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "arrow"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "from": {
          "$ref": "#/definitions/Point"
        },
        "to": {
          "$ref": "#/definitions/Point"
        },
        "stroke": {
          "$ref": "#/definitions/Color",
          "description": "Its color; without one, the theme's arrow color."
        }
      },
      "required": [
        "kind",
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "description": "A free shape that points from one place on the canvas to another."
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "A point on the canvas, in canvas units, at most ten million from its origin either way."
    },
    "StackingOrder": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/StackingList"
      },
      "propertyNames": {
        "description": "An identifier, generated once and never reused. Files refer to each other only by id. Element and relation ids share one namespace, because a relation can end on either. Component and relation type ids start with their package's id, as in `systems.service`.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "description": "Stacking lists by the id of the container whose contents they order, or World's id for the shapes directly in World.",
      "minProperties": 1
    },
    "StackingList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Id"
      },
      "description": "Element ids, from back to front.",
      "minItems": 1,
      "uniqueItems": true
    },
    "CollapsedList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Id"
      },
      "description": "Element ids, sorted, each once.",
      "minItems": 1,
      "uniqueItems": true
    },
    "Routes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/RelationRoute"
      },
      "propertyNames": {
        "description": "An identifier, generated once and never reused. Files refer to each other only by id. Element and relation ids share one namespace, because a relation can end on either. Component and relation type ids start with their package's id, as in `systems.service`.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "description": "Routes chosen by hand, by the id of the relation each one routes.",
      "minProperties": 1
    },
    "RelationRoute": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/EndAttachment",
          "description": "Where the line attaches to the relation's `from` end. An end that is a relation takes none: the line attaches to the middle of that relation's line."
        },
        "to": {
          "$ref": "#/definitions/EndAttachment",
          "description": "Where the line attaches to the relation's `to` end."
        },
        "style": {
          "type": "string",
          "enum": [
            "straight",
            "curved"
          ],
          "description": "`straight` runs straight from point to point and `curved` runs a smooth curve through them; left out, the route is orthogonal."
        },
        "container": {
          "$ref": "#/definitions/Id",
          "description": "The container whose shape the bend points are relative to: one that holds the shapes of both ends, the nearest when they were set. Left out, they are relative to the canvas. While its shape no longer holds both ends, the bend points are ignored, and they come back with the containment."
        },
        "bendPoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Point"
          },
          "description": "The points the line passes through, in order from its `from` end, in canvas units, relative to the shape of `container`, or to the canvas.",
          "minItems": 1,
          "maxItems": 64
        }
      },
      "additionalProperties": false,
      "description": "How a view routes one relation by hand: only what differs from its automatic route. An end left out attaches where the automatic route attaches it, a route without bend points runs directly between its ends, and one without a style is orthogonal.",
      "minProperties": 1
    },
    "EndAttachment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "connection-point",
            "border"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "connection-point"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ConnectionPointAttachment"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "border"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/BorderAttachment"
          }
        }
      ],
      "description": "Where a line attaches to one of its ends, chosen by hand: one of the end's connection points, by name, or a fixed place on its border."
    },
    "ConnectionPointAttachment": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "connection-point"
        },
        "name": {
          "type": "string",
          "description": "The name of one of the connection points of the end's appearance.",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "description": "The line attaches at one of the end's connection points, wherever the end's appearance puts it."
    },
    "BorderAttachment": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "border"
        },
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "at": {
          "type": "number",
          "description": "Where it sits along its side, from 0 at the side's left or top end to 1 at its right or bottom end.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "side",
        "at"
      ],
      "additionalProperties": false,
      "description": "The line attaches at a fixed place on the end's border, which follows the shape as it moves and resizes."
    },
    "Scope": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopeRule"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopeRule"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "added": {
          "$ref": "#/definitions/ScopeList",
          "description": "Elements shown whatever the rules say: ids, sorted, each once, none of them in `leftOut`."
        },
        "leftOut": {
          "$ref": "#/definitions/ScopeList",
          "description": "Elements left out whatever the rules say: ids, sorted, each once, none of them in `added`."
        }
      },
      "additionalProperties": false,
      "description": "The part of the model a view shows: the elements that meet one of its `include` rules, or every element when it has none, and none of its `exclude` rules; then those it adds, less those it leaves out. World always shows, and a relation shows while both its ends do.",
      "minProperties": 1
    },
    "ScopeRule": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "component",
            "relation-type",
            "contents",
            "attribute"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "component"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ComponentRule"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "relation-type"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/RelationTypeRule"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "contents"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/ContentsRule"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "attribute"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/definitions/AttributeRule"
          }
        }
      ],
      "description": "A rule of a scope: which elements it takes."
    },
    "ComponentRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "component"
        },
        "component": {
          "$ref": "#/definitions/Id"
        },
        "exactly": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "component"
      ],
      "additionalProperties": false,
      "description": "The elements created from a component, and from every component derived from it unless `exactly`."
    },
    "RelationTypeRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "relation-type"
        },
        "relationType": {
          "$ref": "#/definitions/Id"
        },
        "exactly": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "relationType"
      ],
      "additionalProperties": false,
      "description": "The elements at either end of a relation of a relation type, or of one derived from it unless `exactly`."
    },
    "ContentsRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "contents"
        },
        "container": {
          "$ref": "#/definitions/Id"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "kind",
        "container"
      ],
      "additionalProperties": false,
      "description": "A container and what sits inside it through the view's nesting relation types: `depth` levels down, or every level without it."
    },
    "AttributeRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "attribute"
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "enum": [
            "is",
            "is-not",
            "contains",
            "below",
            "above",
            "set",
            "unset"
          ]
        },
        "value": {
          "type": "string",
          "description": "What the value is compared with; left out for `set` and `unset`."
        }
      },
      "required": [
        "kind",
        "attribute",
        "test"
      ],
      "additionalProperties": false,
      "description": "The elements whose attribute meets a test, as filters test it, with its component's default when unset."
    },
    "ScopeList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Id"
      },
      "description": "Element ids, sorted, each once.",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "RelationTypesLeftOut": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RelationTypeLeftOut"
      },
      "description": "The relation types a view leaves out (ADR 0064), sorted by relation type, each once.",
      "minItems": 1,
      "maxItems": 256
    },
    "RelationTypeLeftOut": {
      "type": "object",
      "properties": {
        "relationType": {
          "$ref": "#/definitions/Id"
        },
        "exactly": {
          "type": "boolean"
        }
      },
      "required": [
        "relationType"
      ],
      "additionalProperties": false,
      "description": "A relation type a view leaves out, with every relation type derived from it unless `exactly`."
    },
    "Overlays": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Overlay"
      },
      "description": "A view's overlays, in order.",
      "minItems": 1,
      "maxItems": 16
    },
    "Overlay": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "fill",
            "stroke",
            "size",
            "badge",
            "opacity"
          ]
        }
      },
      "required": [
        "channel"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "type": "string",
                "const": "fill"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "$ref": "#/definitions/FillOverlay"
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "type": "string",
                "const": "stroke"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "$ref": "#/definitions/StrokeOverlay"
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "type": "string",
                "const": "size"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "$ref": "#/definitions/SizeOverlay"
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "type": "string",
                "const": "badge"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "$ref": "#/definitions/BadgeOverlay"
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "type": "string",
                "const": "opacity"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "$ref": "#/definitions/OpacityOverlay"
          }
        }
      ],
      "description": "A rule of a view that colors, sizes, marks or fades its shapes by one attribute, which its legend explains (ADR 0055). It maps the attribute to one channel."
    },
    "FillOverlay": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Unique among the view's overlays."
        },
        "name": {
          "type": "string",
          "description": "What the legend calls it; without one, the attribute's name.",
          "minLength": 1,
          "maxLength": 64
        },
        "of": {
          "type": "string",
          "enum": [
            "elements",
            "relations"
          ],
          "description": "Whether it reads the attributes of elements and changes their shapes, or of relations and changes their lines."
        },
        "attribute": {
          "type": "string",
          "description": "The attribute it reads: an element's or relation's own value, or the default its component or relation type gives.",
          "minLength": 1
        },
        "off": {
          "type": "boolean",
          "description": "Whether it is turned off: kept in the view, it changes nothing and its legend is left out."
        },
        "channel": {
          "type": "string",
          "const": "fill"
        },
        "mapping": {
          "$ref": "#/definitions/ColorMapping"
        }
      },
      "required": [
        "attribute",
        "channel",
        "id",
        "mapping",
        "of"
      ],
      "additionalProperties": false,
      "description": "Fills shapes with a color by the attribute; relations have no fill."
    },
    "ColorMapping": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "discrete",
            "continuous",
            "passthrough"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
