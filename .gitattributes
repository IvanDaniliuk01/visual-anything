* text=auto eol=lf

# Project files are JSON.
*.vaproject linguist-language=JSON
*.vamodel linguist-language=JSON
*.vapackage linguist-language=JSON
*.vaview linguist-language=JSON
*.vascenario linguist-language=JSON
*.vatour linguist-language=JSON
*.vacomment linguist-language=JSON

# Project files merge by id, once each person runs `visual-anything merge-driver --install` (ADR 0072).
*.vaproject merge=visual-anything
*.vamodel merge=visual-anything
*.vapackage merge=visual-anything
*.vaview merge=visual-anything
*.vascenario merge=visual-anything
*.vatour merge=visual-anything
*.vacomment merge=visual-anything

# Solid files are binary glTF, cleaned by the program and named by their hash (ADR 0075).
*.glb binary
