{
  "world": {
    "id": "world",
    "component": "essence",
    "name": "World"
  },
  "elements": [
    {
      "id": "customer",
      "component": "c4.person",
      "name": "Personal banking customer",
      "description": "A customer of the bank, with personal accounts."
    },
    {
      "id": "internet-banking",
      "component": "c4.software-system",
      "name": "Internet banking system",
      "description": "Lets customers read about their accounts and make payments."
    },
    {
      "id": "mainframe",
      "component": "c4.software-system",
      "name": "Mainframe banking system",
      "description": "Keeps the core banking information: customers, accounts and transactions.",
      "attributes": {
        "external": true
      }
    },
    {
      "id": "email-system",
      "component": "c4.software-system",
      "name": "E-mail system",
      "description": "The bank’s e-mail system, which another team runs.",
      "attributes": {
        "external": true
      }
    },
    {
      "id": "web-app",
      "component": "c4.container",
      "name": "Web application",
      "description": "Delivers the single-page app and its static content.",
      "attributes": {
        "technology": "Java and Spring MVC"
      }
    },
    {
      "id": "spa",
      "component": "c4.container",
      "name": "Single-page app",
      "description": "Gives customers every internet banking function in their browser.",
      "attributes": {
        "technology": "TypeScript and Angular"
      }
    },
    {
      "id": "mobile-app",
      "component": "c4.container",
      "name": "Mobile app",
      "description": "Gives customers the most used functions on their phone.",
      "attributes": {
        "technology": "Kotlin and Swift"
      }
    },
    {
      "id": "api-app",
      "component": "c4.container",
      "name": "API application",
      "description": "Gives the banking functions over a JSON API.",
      "attributes": {
        "technology": "Java and Spring Boot"
      }
    },
    {
      "id": "database",
      "component": "c4.container",
      "name": "Database",
      "description": "Keeps registrations, hashed credentials and access logs.",
      "attributes": {
        "technology": "PostgreSQL"
      }
    },
    {
      "id": "sign-in-controller",
      "component": "c4.component",
      "name": "Sign-in controller",
      "description": "Lets customers sign in.",
      "attributes": {
        "technology": "Spring REST controller"
      }
    },
    {
      "id": "accounts-controller",
      "component": "c4.component",
      "name": "Accounts controller",
      "description": "Gives customers a summary of their accounts.",
      "attributes": {
        "technology": "Spring REST controller"
      }
    },
    {
      "id": "security-component",
      "component": "c4.component",
      "name": "Security component",
      "description": "Checks credentials and changes passwords.",
      "attributes": {
        "technology": "Spring bean"
      }
    },
    {
      "id": "mainframe-facade",
      "component": "c4.component",
      "name": "Mainframe facade",
      "description": "Talks to the mainframe banking system.",
      "attributes": {
        "technology": "Spring bean"
      }
    },
    {
      "id": "data-center",
      "component": "c4.deployment-node",
      "name": "Bank data center",
      "description": "Where the bank runs its own servers.",
      "attributes": {
        "technology": "Big Bank plc"
      }
    },
    {
      "id": "app-server",
      "component": "c4.deployment-node",
      "name": "Application server",
      "description": "Runs the web and API applications.",
      "attributes": {
        "technology": "Ubuntu 24.04 LTS"
      }
    },
    {
      "id": "db-server",
      "component": "c4.deployment-node",
      "name": "Database server",
      "description": "Runs the database, with a standby beside it.",
      "attributes": {
        "technology": "Ubuntu 24.04 LTS"
      }
    },
    {
      "id": "customer-computer",
      "component": "c4.deployment-node",
      "name": "Customer’s computer",
      "description": "Any desktop browser.",
      "attributes": {
        "technology": "Windows, macOS or Linux"
      }
    },
    {
      "id": "customer-phone",
      "component": "c4.deployment-node",
      "name": "Customer’s phone",
      "description": "A phone with the bank’s app installed.",
      "attributes": {
        "technology": "iOS or Android"
      }
    }
  ],
  "relations": [
