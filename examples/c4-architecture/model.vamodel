    {
      "id": "customer-visits-web-app",
      "relationType": "c4.uses",
      "from": "customer",
      "to": "web-app",
      "name": "Visits the internet banking site",
      "attributes": {
        "technology": "HTTPS"
      }
    },
    {
      "id": "web-app-delivers-spa",
      "relationType": "c4.delivers-to",
      "from": "web-app",
      "to": "customer",
      "name": "Delivers the single-page app",
      "attributes": {
        "technology": "HTTPS"
      }
    },
    {
      "id": "customer-uses-spa",
      "relationType": "c4.uses",
      "from": "customer",
      "to": "spa",
      "name": "Signs in and reads their accounts"
    },
    {
      "id": "customer-uses-mobile-app",
      "relationType": "c4.uses",
      "from": "customer",
      "to": "mobile-app",
      "name": "Reads their accounts on the go"
    },
    {
      "id": "spa-signs-in",
      "relationType": "c4.uses",
      "from": "spa",
      "to": "sign-in-controller",
      "name": "Sends the credentials",
      "attributes": {
        "technology": "JSON over HTTPS"
      }
    },
    {
      "id": "spa-gets-accounts",
      "relationType": "c4.uses",
      "from": "spa",
      "to": "accounts-controller",
      "name": "Asks for the accounts",
      "attributes": {
        "technology": "JSON over HTTPS"
      }
    },
    {
      "id": "mobile-app-signs-in",
      "relationType": "c4.uses",
      "from": "mobile-app",
      "to": "sign-in-controller",
      "name": "Sends the credentials",
      "attributes": {
        "technology": "JSON over HTTPS"
      }
    },
    {
      "id": "mobile-app-gets-accounts",
      "relationType": "c4.uses",
      "from": "mobile-app",
      "to": "accounts-controller",
      "name": "Asks for the accounts",
      "attributes": {
        "technology": "JSON over HTTPS"
      }
    },
    {
      "id": "sign-in-checks-credentials",
      "relationType": "c4.uses",
      "from": "sign-in-controller",
      "to": "security-component",
      "name": "Checks the credentials"
    },
    {
      "id": "accounts-ask-facade",
      "relationType": "c4.uses",
      "from": "accounts-controller",
      "to": "mainframe-facade",
      "name": "Asks for the balances"
    },
    {
      "id": "security-reads-database",
      "relationType": "c4.uses",
      "from": "security-component",
      "to": "database",
      "name": "Reads the hashed credentials",
      "attributes": {
        "technology": "SQL"
      }
    },
    {
      "id": "security-sends-notice",
      "relationType": "c4.uses",
      "from": "security-component",
      "to": "email-system",
      "name": "Sends a sign-in notice",
      "attributes": {
        "technology": "SMTP"
      }
    },
    {
      "id": "facade-calls-mainframe",
      "relationType": "c4.uses",
      "from": "mainframe-facade",
      "to": "mainframe",
      "name": "Gets the balances",
      "attributes": {
        "technology": "XML over HTTPS"
      }
    },
    {
      "id": "email-delivers-notice",
      "relationType": "c4.delivers-to",
      "from": "email-system",
      "to": "customer",
      "name": "E-mails the sign-in notice",
      "attributes": {
        "technology": "SMTP"
      }
    }
  ]
