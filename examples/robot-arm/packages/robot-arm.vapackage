{
  "id": "robot-arm",
  "name": "Pick-and-place arm",
  "description": "The sample’s own package: the arm’s solid, which its links, joints and gripper are anchored to, and the workcell it works in, with its table and bins.",
  "version": "1.0.0",
  "license": "CC0-1.0",
  "attribution": "Visual Anything contributors",
  "components": [
    {
      "id": "robot-arm.workcell",
      "name": "Workcell",
      "derivesFrom": "essence",
      "description": "The fenced cell a robot works in, with what it works on: its table, its bins and the cameras that watch them.",
      "appearance": {
        "shape": "rounded-rectangle",
        "fill": "#F4F6F8",
        "stroke": "#3E4A57",
        "width": 640,
        "height": 400
      }
    },
    {
      "id": "robot-arm.table",
      "name": "Table",
      "derivesFrom": "essence",
      "description": "A table a robot is bolted to, or that holds what it works on.",
      "attributes": [
        {
          "name": "height",
          "type": "number",
          "description": "How high its top is.",
          "unit": "m"
