        "stroke": "#8A5A00",
        "width": 176,
        "height": 72
      }
    }
  ],
  "relationTypes": [
    {
      "id": "robot-arm.is-in",
      "name": "is in",
      "derivesFrom": "relates-to",
      "description": "Places the arm, a table, a bin or a camera in the workcell, or a part in its bin: it is posed there, and moves with it.",
      "direction": "directed",
      "nests": true
    },
    {
      "id": "robot-arm.is-mounted-on",
      "name": "is mounted on",
      "derivesFrom": "physical-ai.is-attached-to",
      "description": "Mounts a sensor on the link it rides on: it is posed in that link, and moves with it.",
      "nests": true
    }
  ],
