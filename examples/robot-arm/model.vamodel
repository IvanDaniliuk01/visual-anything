        }
      }
    },
    {
      "id": "joint-3",
      "component": "physical-ai.joint",
      "name": "Joint 3",
      "description": "The elbow: bends the forearm.",
      "attributes": {
        "axis": "1 0 0",
        "kind": "revolute",
        "lowerLimit": -150,
        "upperLimit": 150
      },
      "appearance": {
        "part": {
          "part": "joint-3",
