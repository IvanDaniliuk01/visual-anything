        "length": 0.08,
        "mass": 0.6
      },
      "appearance": {
        "part": {
          "part": "link-5",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "joint-6",
      "component": "physical-ai.joint",
      "name": "Joint 6",
      "description": "Turns the tool without end.",
      "attributes": {
        "axis": "0 0 1",
        "kind": "continuous"
      },
      "appearance": {
        "part": {
          "part": "joint-6",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "link-6",
      "component": "physical-ai.link",
      "name": "Link 6",
      "description": "The tool flange the gripper and the camera are mounted on.",
      "attributes": {
        "length": 0.03,
        "mass": 0.2
      },
      "appearance": {
        "part": {
          "part": "link-6",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "gripper",
      "component": "physical-ai.gripper",
      "name": "Gripper",
      "description": "Two parallel jaws that close on the part.",
      "appearance": {
        "part": {
          "part": "gripper",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "wrist-camera",
      "component": "physical-ai.camera",
      "name": "Wrist camera",
      "description": "Mounted on link 6, the tool flange, just above the gripper: looks past it at what it is about to pick.",
      "attributes": {
        "frame": "camera_link",
        "rate": 30
      },
      "appearance": {
        "part": {
          "part": "camera",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "motor-1",
      "component": "physical-ai.motor",
      "name": "Motor 1",
      "description": "Turns the whole arm about its base, through its gearbox: it drives joint 1.",
      "attributes": {
        "torque": 300
      }
    },
    {
      "id": "motor-2",
      "component": "physical-ai.motor",
      "name": "Motor 2",
      "description": "Lifts the upper arm at the shoulder, through its gearbox: it drives joint 2.",
      "attributes": {
        "torque": 150
      }
    },
    {
      "id": "motor-3",
      "component": "physical-ai.motor",
      "name": "Motor 3",
      "description": "Bends the forearm at the elbow, through its gearbox: it drives joint 3.",
      "attributes": {
        "torque": 80
      }
    },
    {
      "id": "motor-4",
      "component": "physical-ai.motor",
      "name": "Motor 4",
      "description": "Rolls the forearm, through its gearbox: it drives joint 4.",
      "attributes": {
        "torque": 25
      }
    },
    {
      "id": "motor-5",
      "component": "physical-ai.motor",
      "name": "Motor 5",
      "description": "Bends the wrist, through its gearbox: it drives joint 5.",
      "attributes": {
        "torque": 25
      }
    },
    {
      "id": "motor-6",
      "component": "physical-ai.motor",
      "name": "Motor 6",
      "description": "Turns the tool, through its gearbox: it drives joint 6.",
      "attributes": {
        "torque": 10
      }
    },
    {
      "id": "encoder-1",
      "component": "physical-ai.encoder",
      "name": "Encoder 1",
      "description": "Reads the angle of joint 1.",
      "attributes": {
        "frame": "joint_1",
        "rate": 1000
      }
    },
    {
      "id": "encoder-2",
