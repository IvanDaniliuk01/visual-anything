        "rate": 1000
      }
    },
    {
      "id": "grasp-policy",
      "component": "physical-ai.policy",
      "name": "Grasp policy",
      "description": "Learned from demonstrations; picks the next joint targets from the camera’s images.",
      "attributes": {
        "kind": "policy",
        "model": "a diffusion policy",
        "rate": 10
      }
    },
    {
      "id": "joint-controller",
      "component": "physical-ai.controller",
      "name": "Joint controller",
      "description": "Holds each joint at its target.",
      "attributes": {
        "kind": "PID",
        "rate": 1000
      }
    },
    {
      "id": "workcell",
      "component": "robot-arm.workcell",
      "name": "Workcell",
      "description": "The fenced cell the arm works in, 2 m by 1.6 m: its table, the bin it picks from, the bin it places in, and the camera above them.",
