        "rate": 1000
      }
    },
    {
      "id": "encoder-4",
      "component": "physical-ai.encoder",
      "name": "Encoder 4",
      "description": "Reads the angle of joint 4.",
      "attributes": {
        "frame": "joint_4",
        "rate": 1000
      }
    },
    {
      "id": "encoder-5",
      "component": "physical-ai.encoder",
      "name": "Encoder 5",
