{
  "world": {
    "id": "world",
    "component": "essence",
    "name": "World"
  },
  "elements": [
    {
      "id": "arm",
      "component": "physical-ai.robot",
      "name": "Six-axis arm",
      "description": "Picks each part from bin A and places it in bin B. It is drawn as its solid, which you can turn.",
      "attributes": {
        "degreesOfFreedom": 6,
        "model": "six-axis arm"
      },
      "appearance": {
        "solid": {
          "solid": "robot-arm.six-axis-arm",
          "placement": "parts"
        }
      },
      "pose": {
        "in": "workcell",
        "at": {
          "x": 0,
          "y": 0.75,
          "z": -0.25
        }
      }
    },
    {
      "id": "base",
      "component": "physical-ai.link",
      "name": "Base",
      "description": "Bolted to the table.",
      "attributes": {
        "mass": 12
      },
      "appearance": {
        "part": {
          "part": "base",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "joint-1",
      "component": "physical-ai.joint",
      "name": "Joint 1",
      "description": "Turns the whole arm about its base.",
      "attributes": {
        "axis": "0 1 0",
        "kind": "revolute",
        "lowerLimit": -170,
        "upperLimit": 170
      },
      "appearance": {
        "part": {
          "part": "joint-1",
          "solid": "robot-arm.six-axis-arm"
        }
      }
    },
    {
      "id": "link-1",
      "component": "physical-ai.link",
      "name": "Link 1",
      "description": "The column the shoulder sits on.",
      "attributes": {
        "length": 0.16,
        "mass": 4.2
      },
      "appearance": {
        "part": {
