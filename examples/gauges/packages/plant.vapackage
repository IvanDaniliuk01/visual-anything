{
  "id": "plant",
  "name": "Plant",
  "description": "Thermometers that convert, check and draw their readings with package code.",
  "components": [
    {
      "id": "plant.thermometer",
      "name": "Thermometer",
      "derivesFrom": "systems.box",
      "description": "A sensor that reads a temperature.",
      "attributes": [
        {
          "name": "celsius",
          "type": "number",
          "description": "The last reading.",
          "unit": "°C"
        }
      ],
      "appearance": {
        "shape": "rounded-rectangle",
        "width": 176,
        "height": 136,
        "detail": {
          "componentName": false
        }
      }
    }
  ],
  "relationTypes": [
    {
      "id": "plant.heats",
      "name": "heats",
      "derivesFrom": "systems.communicates-with",
      "description": "Warms what it ends on."
    }
  ],
  "code": [
    "/**",
    " * Package code for the plant (ADR 0054): a unit converter, a check and a gauge. Each hook gets a",
    " * frozen copy of the element and what lies around it, and returns plain data; the app draws the",
    " * gauge, and nothing here touches the canvas, the page or the network.",
    " */",
    "const LOWEST = -40;",
    "const HIGHEST = 120;",
    "const RATED = 90;",
    "",
    "/** Computed, shown with a mark and never saved: the reading in Fahrenheit. */",
    "export function attributes(element) {",
    "  const celsius = element.attributes.celsius;",
    "  if (typeof celsius !== 'number') return {};",
    "  return { fahrenheit: Math.round((celsius * 9) / 5 + 32) };",
    "}",
    "",
    "/** Warnings, as relation type limits give them: a reading past what it is rated for, or none. */",
    "export function check(element) {",
    "  const celsius = element.attributes.celsius;",
    "  if (typeof celsius !== 'number') return ['It has no reading: set its celsius.'];",
    "  if (celsius > RATED) return [`${celsius} °C is over the ${RATED} °C it is rated for.`];",
    "  if (celsius < LOWEST) return [`${celsius} °C is below what its sensor reads.`];",
    "  return [];",
    "}",
    "",
    "/** A gauge drawn inside the shape: a scale, the share of it the reading fills, a needle. */",
    "export function draw(element, context) {",
    "  const celsius = element.attributes.celsius;",
    "  const known = typeof celsius === 'number';",
    "  const share = known ? Math.min(1, Math.max(0, (celsius - LOWEST) / (HIGHEST - LOWEST))) : 0;",
    "  const angle = 180 + share * 180;",
    "  const radians = (angle * Math.PI) / 180;",
    "  const hot = known && celsius > RATED;",
    "  const items = [",
    "    { kind: 'arc', x: 50, y: 50, radius: 38, from: 180, to: 360, stroke: '#C9CED6', strokeWidth: 8 },",
    "    {",
    "      kind: 'arc',",
    "      x: 50,",
    "      y: 50,",
    "      radius: 38,",
    "      from: 180,",
    "      to: Math.max(181, angle),",
    "      stroke: hot ? '#C62828' : '#2F7D4F',",
    "      strokeWidth: 8,",
    "    },",
    "    {",
    "      kind: 'line',",
    "      points: [",
    "        { x: 50, y: 50 },",
    "        { x: 50 + 30 * Math.cos(radians), y: 50 + 30 * Math.sin(radians) },",
    "      ],",
    "      strokeWidth: 2,",
    "    },",
    "    { kind: 'ellipse', x: 46, y: 46, width: 8, height: 8 },",
    "  ];",
    "  // Close in, it writes the reading too.",
    "  if (context.scale >= 1) {",
    "    items.push({ kind: 'text', x: 50, y: 64, text: known ? `${celsius} °C` : 'no reading', align: 'middle', size: 11 });",
    "  }",
    "  return { width: 100, height: 66, items };",
    "}"
  ]
}
