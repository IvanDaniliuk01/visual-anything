{
  "id": "how-visual-anything-works-abpwgu",
  "name": "How Visual Anything works",
  "description": "Its four packages, then one shape's move from the canvas to the files and back to every app.",
  "steps": [
    {
      "id": "step-9hgo12",
      "viewState": {
        "view": "overview",
