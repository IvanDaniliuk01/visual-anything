        "model": "Claude, in Claude Code or Claude Desktop"
      }
    },
    {
      "id": "browser-kvjvxb",
      "component": "systems.box",
      "name": "Browser",
      "description": "The person's desktop browser: each tab that has the project open runs the app."
    },
    {
      "id": "web-origin-8z645q",
      "component": "systems.box",
      "name": "Web origin",
      "description": "An https origin that a package's code was granted, on a public address (ADR 0063)."
    },
    {
      "id": "file-system-6yurvg",
      "component": "systems.box",
      "name": "File system",
      "description": "The disk of the computer Visual Anything runs on."
    },
    {
      "id": "project-folder-ptj3sb",
      "component": "code.folder",
      "name": "Project folder",
      "description": "A project: plain JSON files, validated when opened and written with a stable key order, kept in git.",
      "attributes": {
        "holds": "project.vaproject, model.vamodel, packages/*.vapackage, views/*.vaview, scenarios/*.vascenario, tours/*.vatour, comments/*.vacomment",
        "location": "The folder the program opens, such as examples/visual-anything"
      }
    },
    {
      "id": "preferences-folder-pyjr25",
      "component": "code.folder",
      "name": "Preferences folder",
      "description": "Each person's preferences, outside every project (ADR 0032).",
      "attributes": {
        "holds": "preferences.json: theme, language, grid, snapping, rulers, recent colors, code approvals, comment author",
        "location": "%APPDATA%\\Visual Anything on Windows, ~/Library/Application Support/Visual Anything on macOS, ~/.config/visual-anything elsewhere; VISUAL_ANYTHING_PREFERENCES chooses another"
      }
    },
    {
      "id": "runtime-folder-sfstje",
      "component": "code.folder",
      "name": "Runtime folder",
      "description": "Where each running program leaves the record that lets Claude's MCP entry point attach to it; only the person's account can read it.",
      "attributes": {
        "holds": "one record per program (port, folder, protocol version, the Claude credential), and the output of programs Claude started",
        "location": "%LOCALAPPDATA%\\Visual Anything\\run on Windows, ~/Library/Application Support/Visual Anything/run on macOS, $XDG_RUNTIME_DIR/visual-anything elsewhere; VISUAL_ANYTHING_RUNTIME chooses another"
      }
    },
    {
      "id": "visual-anything-ksmhdr",
      "component": "systems.system",
      "name": "Visual Anything",
      "description": "The local-first tool to make any concept or system visual: one local Node program and a browser app, in a pnpm workspace of four packages."
    },
    {
      "id": "core-hnt4ih",
      "component": "code.package",
      "name": "core",
      "description": "@visual-anything/core: the model, commands, invariants and the undo history. Only core changes the model, and only through commands.",
      "attributes": {
        "io": "none: no files, no network",
        "language": "TypeScript",
        "runsIn": "Node and the browser",
        "tests": "Vitest, with property tests for the invariants (fast-check)"
      }
    },
    {
      "id": "schema-nd8g5w",
      "component": "code.package",
      "name": "schema",
      "description": "@visual-anything/schema: the project file types, the JSON Schema generated from them, validation and the stable format.",
      "attributes": {
        "io": "none",
        "language": "TypeScript, with Ajv and ts-json-schema-generator",
        "runsIn": "Node and the browser",
        "tests": "Vitest, with fast-check"
      }
    },
    {
      "id": "server-w4u6le",
      "component": "code.package",
      "name": "server",
      "description": "@visual-anything/server: the local program. It owns the model and its history (ADR 0016), serves the app on 127.0.0.1, reads and writes the project folder, and is Claude's MCP server.",
      "attributes": {
        "io": "files, HTTP and WebSocket on 127.0.0.1, stdio, child processes, https fetches for approved package code",
        "language": "TypeScript on Node 22.13 or later, with ws, open and the MCP SDK",
        "runsIn": "Node, or one executable per system (ADR 0037)",
        "tests": "Vitest"
      }
    },
    {
      "id": "app-kk6aff",
      "component": "code.package",
      "name": "app",
      "description": "@visual-anything/app: the React UI. The canvas is drawn with PixiJS (ADR 0014) and ELK layout runs in a Web Worker (ADR 0015). It sends commands and renders what comes back.",
      "attributes": {
        "io": "the WebSocket to the program, workers, BroadcastChannel between tabs",
        "language": "TypeScript with React 19, PixiJS 8, elkjs and QuickJS",
        "runsIn": "the browser",
        "tests": "Vitest with jsdom and Testing Library, some fast-check; benchmarks in a browser"
      }
    },
