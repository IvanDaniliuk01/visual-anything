      "id": "canvas-lbfjd4",
      "component": "code.module",
      "name": "Canvas",
      "description": "The surface the open view is drawn and edited on.",
      "attributes": {
        "source": "canvas/CanvasArea.tsx"
      }
    },
    {
      "id": "controller-n8tse7",
      "component": "code.module",
      "name": "Controller",
      "description": "Turns pointer and keyboard gestures into commands (a drag ends as one set-positions, a drop on a container as change-container) and hands each new scene to the renderer.",
      "attributes": {
        "source": "canvas/controller.ts, gestures.ts, drop.ts"
      }
    },
    {
      "id": "scene-wm5jec",
      "component": "code.module",
      "name": "Scene",
      "description": "What the view draws: shapes, rows and relations with their places, aggregated relations of collapsed containers, filters and focus, indexed for hit tests.",
      "attributes": {
        "source": "canvas/scene.ts, hit.ts"
      }
    },
    {
      "id": "renderer-e9aatb",
      "component": "code.module",
      "name": "Renderer",
      "description": "Draws the scene with WebGL, with an HTML layer for text being edited (ADR 0014).",
      "attributes": {
        "source": "canvas/renderer.ts",
        "technology": "PixiJS 8"
      }
    },
    {
      "id": "tiles-h57j40",
      "component": "code.module",
      "name": "Tiles",
      "description": "The canvas cut into tiles, so that an action redraws only the tiles it changed.",
      "attributes": {
        "source": "canvas/tiles.ts"
      }
    },
    {
      "id": "routes-dwklah",
      "component": "code.module",
      "name": "Routes",
      "description": "Where each relation's line runs: orthogonal by default, or as chosen by hand (ADR 0039).",
      "attributes": {
        "source": "canvas/routing/, route.ts"
      }
    },
    {
      "id": "layout-worker-i5cc8n",
      "component": "code.module",
      "name": "Layout worker",
      "description": "Lays out a view off the main thread, pinned shapes as fixed inputs; the result comes back as one command (ADR 0015).",
      "attributes": {
        "source": "canvas/layout/",
        "technology": "ELK (elkjs) in a Web Worker"
      }
    },
    {
      "id": "live-connection-lh20ap",
      "component": "code.module",
      "name": "Live connection",
      "description": "The tab's WebSocket to the program: sends commands, undo and redo, applies each change it pushes, and shares the session with the browser's other tabs (ADR 0043).",
      "attributes": {
        "source": "live/connection.ts, live/session.ts, live/share.ts"
      }
    },
    {
      "id": "package-code-worker-ig5gg6",
      "component": "code.module",
      "name": "Package-code worker",
      "description": "Runs approved package code in QuickJS inside WebAssembly, one runtime per package, within 50 ms and 32 MiB a call (ADR 0054).",
      "attributes": {
        "source": "code/",
        "technology": "QuickJS in a Web Worker"
      }
    },
    {
      "id": "find-bar-6a2547",
      "component": "code.module",
      "name": "Find bar",
      "description": "Ctrl+F over names, ids, components and attribute values, grouped by view; Enter selects and shows.",
      "attributes": {
        "source": "search/"
      }
    },
    {
      "id": "import-dialog-xi8ebh",
      "component": "code.module",
      "name": "Import dialog",
      "description": "Reads a file or pasted text in the tab, maps its kinds, and sends the import as one command.",
      "attributes": {
        "source": "import/"
      }
    },
    {
      "id": "export-dialog-flhm4n",
      "component": "code.module",
      "name": "Export dialog",
      "description": "PNG, SVG, PDF, text exports and the read-only page, each with its size and what it leaves out.",
      "attributes": {
        "source": "export/"
      }
    },
    {
      "id": "scenario-playback-n01j8d",
      "component": "code.module",
      "name": "Scenario playback",
      "description": "The scenario panel: record, play, step, speed, the travelling marker and the step's data.",
      "attributes": {
        "source": "scenarios/"
      }
    },
    {
      "id": "tours-panel-huikrh",
      "component": "code.module",
      "name": "Tours panel",
      "description": "Tours made from view states and played full screen.",
      "attributes": {
        "source": "tours/"
      }
    },
    {
      "id": "history-panel-ws3x3i",
      "component": "code.module",
      "name": "History panel",
      "description": "Each action's label, author and time, and Undo to here.",
      "attributes": {
        "source": "history/"
      }
    },
    {
      "id": "guidance-layer-5omioy",
      "component": "code.module",
      "name": "Guidance layer",
      "description": "Claude's highlights, focus, moves of the canvas and captions, which change nothing.",
      "attributes": {
        "source": "guidance/"
      }
    },
    {
      "id": "viewer-page-bd4ohc",
      "component": "code.module",
      "name": "Viewer page",
      "description": "The read-only page's own build: every view, scenario and tour in one file, with no token and no connection (ADR 0041).",
      "attributes": {
        "source": "viewer/"
      }
    },
    {
      "id": "start-screen-session-xgj4n5",
      "component": "code.module",
      "name": "Start screen session",
      "description": "The program on a folder that holds no project yet (ADR 0051): it greets each app with the samples a project can start from, writes the one chosen, and from then on is that project's session.",
      "attributes": {
        "source": "start.ts, samples.ts"
      }
    }
