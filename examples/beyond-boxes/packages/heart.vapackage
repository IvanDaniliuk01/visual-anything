{
  "id": "heart",
  "name": "Heart",
  "description": "The heart and the blood it pumps: its chambers, septum, valves and main vessels, drawn as the named parts of one picture, with the lungs and the body the blood flows through.",
  "version": "1.0.0",
  "license": "CC0-1.0",
  "attribution": "Visual Anything contributors",
  "components": [
    {
      "id": "heart.organ",
      "name": "Organ",
      "derivesFrom": "essence",
      "description": "An organ the blood flows through.",
      "appearance": {
        "shape": "rounded-rectangle",
        "fill": "#F6E3E0",
        "stroke": "#9A4038"
      }
    },
    {
      "id": "heart.heart",
      "name": "Heart",
      "derivesFrom": "heart.organ",
      "description": "The heart, drawn with its parts: what sits inside it and names one of the picture’s parts is drawn as that part.",
      "appearance": {
        "image": {
          "image": "heart.heart-picture",
          "placement": "parts"
        }
      }
    },
    {
      "id": "heart.lungs",
      "name": "Lungs",
      "derivesFrom": "heart.organ",
      "description": "Where the blood gives off carbon dioxide and takes up oxygen.",
      "appearance": {
        "fill": "#F2B8B0",
        "width": 200,
        "height": 170,
        "geometry": {
          "width": 200,
          "height": 170,
          "outline": [
            {
              "kind": "path",
              "d": "M62 24 C40 26 20 52 12 84 C4 116 4 146 10 162 C30 154 56 150 90 160 C94 130 94 96 90 62 C88 40 80 24 62 24 Z"
            },
            {
              "kind": "path",
              "d": "M138 24 C160 26 180 52 188 84 C196 116 196 146 190 162 C170 154 150 150 120 160 C124 148 132 138 130 128 C128 118 112 116 110 104 C108 90 110 74 112 62 C114 40 120 24 138 24 Z"
            },
            {
              "kind": "path",
              "d": "M95 0 L105 0 L105 36 L110 46 L106 50 L100 42 L94 50 L90 46 L95 36 Z"
            }
          ],
          "keepProportions": true,
          "label": {
            "x": 14,
            "y": 86,
            "width": 74,
            "height": 32
          }
        }
      }
    },
    {
      "id": "heart.body",
      "name": "Body",
      "derivesFrom": "essence",
      "description": "The tissues the blood brings oxygen to and takes carbon dioxide from.",
      "appearance": {
        "shape": "person",
        "fill": "#F3E6D8",
        "stroke": "#7A5B3A",
        "width": 120,
        "height": 160
      }
    },
    {
      "id": "heart.chamber",
      "name": "Chamber",
      "derivesFrom": "essence",
      "description": "A chamber of the heart: an atrium that receives blood, or a ventricle that pumps it out.",
      "attributes": [
        {
          "name": "blood",
          "type": "string",
          "description": "The blood it holds.",
          "choices": [
            "oxygen-poor",
            "oxygen-rich"
          ]
        }
      ]
    },
    {
      "id": "heart.valve",
      "name": "Valve",
      "derivesFrom": "essence",
      "description": "A valve that lets blood through one way only.",
      "attributes": [
        {
          "name": "cusps",
          "type": "number",
          "description": "How many flaps it closes with."
        }
      ]
    },
    {
      "id": "heart.vessel",
      "name": "Vessel",
      "derivesFrom": "essence",
      "description": "A blood vessel that brings blood to the heart or takes it away.",
      "attributes": [
        {
          "name": "blood",
          "type": "string",
          "description": "The blood it carries.",
          "choices": [
            "oxygen-poor",
            "oxygen-rich"
          ]
        }
      ]
    },
    {
      "id": "heart.wall",
      "name": "Wall",
      "derivesFrom": "essence",
      "description": "A wall of the heart’s muscle."
    },
    {
      "id": "heart.pacemaker",
      "name": "Pacemaker",
      "derivesFrom": "essence",
      "description": "Tissue that starts each heartbeat with an electrical signal.",
      "appearance": {
        "shape": "rounded-rectangle",
        "fill": "#FBEFC9",
        "stroke": "#B7791F",
        "width": 160,
        "height": 56
      }
    },
    {
      "id": "heart.card",
      "name": "Card",
      "derivesFrom": "essence",
      "description": "A card of facts, shown as a drawing imported from HTML.",
      "appearance": {
        "shape": "rectangle",
        "fill": "#FFFFFF",
        "stroke": "#9A4038"
      }
    }
  ],
  "relationTypes": [
    {
      "id": "heart.is-part-of",
      "name": "is part of",
      "derivesFrom": "relates-to",
      "description": "Places a part inside the organ it belongs to.",
      "direction": "directed",
      "nests": true
    },
    {
      "id": "heart.flows-to",
      "name": "flows to",
      "derivesFrom": "relates-to",
      "description": "Blood flows from one end to the other.",
      "direction": "directed",
      "appearance": {
        "width": 2
      }
    },
    {
      "id": "heart.sends-oxygen-poor-blood-to",
      "name": "sends oxygen-poor blood to",
      "derivesFrom": "heart.flows-to",
      "description": "Blood that has given its oxygen to the body flows on, toward the lungs.",
      "appearance": {
        "stroke": "#2F5FA7"
      }
    },
    {
      "id": "heart.sends-oxygen-rich-blood-to",
      "name": "sends oxygen-rich blood to",
      "derivesFrom": "heart.flows-to",
      "description": "Blood that has taken up oxygen in the lungs flows on, toward the body.",
      "appearance": {
        "stroke": "#B3261E"
      }
    },
    {
      "id": "heart.paces",
      "name": "paces",
      "derivesFrom": "relates-to",
      "description": "Sets the rhythm of a chamber with an electrical signal. Its lines are drawn straight in every view.",
      "direction": "directed",
      "appearance": {
        "stroke": "#B7791F",
        "dash": "dashed",
        "route": "straight"
      },
      "limits": {
        "from": [
          "heart.pacemaker"
        ],
        "to": [
          "heart.chamber"
        ]
      }
    }
  ],
