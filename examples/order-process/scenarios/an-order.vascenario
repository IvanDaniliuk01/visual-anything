{
  "id": "an-order",
  "name": "An order",
  "description": "An order goes through the exclusive gateway: when every item is in stock it ships, otherwise it is cancelled and refunded.",
  "view": "order-process",
  "steps": [
    {
      "id": "order",
      "description": "The customer places an order on the website.",
      "relations": [
        "places-order"
      ],
      "dataOut": {
        "items": 3,
        "order": "A-1042"
      }
    },
    {
      "id": "check",
      "description": "The order starts the process, and the shop checks its stock.",
      "relations": [
        "received-to-check",
        "order-with-check"
      ],
      "dataIn": {
        "order": "A-1042"
      }
    },
    {
      "id": "decide",
      "description": "The inventory is read, and the check reaches the exclusive gateway.",
      "relations": [
        "inventory-with-check",
        "check-to-gateway"
      ]
    },
    {
      "id": "to-warehouse",
      "description": "Every item is in stock, so the gateway sends the order to the warehouse.",
      "relations": [
        "in-stock-yes"
      ],
      "dataIn": {
        "inStock": true
      }
    },
    {
      "id": "pack",
      "description": "The items are picked from their shelves and packed.",
      "relations": [
        "pick-to-pack"
      ],
      "dataOut": {
        "parcel": "1 box, 2.4 kg"
      }
    },
    {
      "id": "wait",
      "description": "The parcel waits for the carrier, who comes at 17:00.",
      "relations": [
        "parcel-to-pickup"
      ]
    },
    {
      "id": "hand-over",
      "description": "At 17:00 the parcel is scanned and handed over.",
      "relations": [
        "pickup-to-hand-over"
      ]
    },
    {
      "id": "shipped",
      "description": "The order is shipped.",
      "relations": [
        "hand-over-to-shipped"
      ],
      "dataOut": {
        "tracking": "TRK-58213"
      }
    },
    {
      "id": "tell",
      "description": "The customer gets the tracking number.",
      "relations": [
        "sends-tracking"
      ],
      "dataOut": {
        "tracking": "TRK-58213"
      }
    },
    {
      "id": "to-cancel",
      "description": "An item is out of stock, so the gateway sends the order to be cancelled.",
      "relations": [
        "in-stock-no"
      ],
      "dataIn": {
        "inStock": false
      }
    },
    {
      "id": "cancel",
      "description": "The order is cancelled and its payment refunded.",
      "relations": [
        "cancel-to-end"
      ],
      "dataOut": {
        "refunded": true
      }
    },
    {
      "id": "refund-notice",
      "description": "The customer is told, with the refund.",
      "relations": [
        "sends-refund"
      ]
    }
  ],
  "blocks": [
    {
      "id": "stock-check",
      "kind": "decision",
      "question": "Is every item in stock?",
      "alternatives": [
        {
          "id": "in-stock",
          "label": "Yes",
          "steps": [
            "to-warehouse",
            "pack",
            "wait",
            "hand-over",
            "shipped",
            "tell"
          ]
        },
        {
          "id": "out-of-stock",
          "label": "No",
          "steps": [
            "to-cancel",
            "cancel",
            "refund-notice"
          ]
        }
      ]
    }
  ]
}
