{
  "id": "order-states",
  "name": "The states of an order",
  "description": "The same order, as its state changes from created to closed.",
  "view": "order-lifecycle",
  "steps": [
    {
      "id": "placed",
      "description": "The order is received and placed.",
      "relations": [
        "created-to-placed"
      ]
    },
    {
      "id": "checked",
      "description": "Its stock is checked.",
      "relations": [
        "placed-to-choice"
      ]
    },
    {
      "id": "picking",
      "description": "Every item is in stock, so it goes into fulfilment, starting with picking.",
      "relations": [
        "choice-to-picking"
      ]
    },
    {
      "id": "packing",
      "description": "Its items are picked, then packed.",
      "relations": [
        "picking-to-packing"
      ]
    },
    {
      "id": "awaiting",
      "description": "The box is packed, and waits for the carrier.",
      "relations": [
        "packing-to-awaiting"
      ]
    },
    {
      "id": "shipped",
      "description": "The carrier takes it at 17:00, and the customer gets the tracking number.",
      "relations": [
        "awaiting-to-shipped"
      ]
    },
    {
      "id": "closed",
      "description": "It is delivered, and closed.",
      "relations": [
        "shipped-to-closed"
      ]
    },
    {
      "id": "cancelled",
      "description": "An item is out of stock, so the order is cancelled and refunded.",
      "relations": [
        "choice-to-cancelled"
      ]
    },
    {
      "id": "closed-cancelled",
      "description": "It is closed.",
      "relations": [
        "cancelled-to-closed"
      ]
    }
  ],
  "blocks": [
    {
      "id": "stock-choice",
      "kind": "decision",
      "question": "Is every item in stock?",
      "alternatives": [
        {
          "id": "in-stock",
          "label": "Yes",
          "steps": [
            "picking",
            "packing",
            "awaiting",
            "shipped",
            "closed"
          ]
        },
        {
          "id": "out-of-stock",
          "label": "No",
          "steps": [
            "cancelled",
            "closed-cancelled"
          ]
        }
      ]
    }
  ]
}
